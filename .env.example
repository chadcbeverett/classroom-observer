# Copy this to .env and fill in real values before `docker compose up`.
# The .env file is git-ignored (see .gitignore); do NOT commit it.

# ---- Required ----

# Anthropic API key for the scoring calls. Get one at console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Origin used in magic-link URLs sent by email. HTTPS in production so
# session cookies are marked Secure.
OBSERVER_PUBLIC_URL=https://coach.your-district.org

# SMTP relay. Any provider that speaks SMTP works — Postmark, SendGrid,
# SES, Fastmail, self-hosted Postfix, or Gmail with an app-password.
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=coach@your-district.org

# ---- Optional (defaults shown) ----

# SMTP_STARTTLS=1                  # set to 0 only for plain-SMTP dev relays
# OBSERVER_LOG_FORMAT=json         # structured JSON logs (default: text)
